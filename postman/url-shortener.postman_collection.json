                "v1",
                "urls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"longUrl\": \"http://127.0.0.1:8080/admin\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400: SSRF, cloud metadata address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error code is INVALID_URL\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_URL\"));",
                  "pm.test(\"body carries requestId and no internals\", () => {",
                  "  const b = pm.response.json();",
