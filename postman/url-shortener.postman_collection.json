                "v1",
                "urls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"longUrl\": \"https://example.com\", \"customAlias\": \"Admin\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400: invalid alias pattern",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
