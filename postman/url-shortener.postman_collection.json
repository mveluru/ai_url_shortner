        {
          "name": "400: reserved alias (case-insensitive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error code is ALIAS_RESERVED\", () => pm.expect(pm.response.json().code).to.eql(\"ALIAS_RESERVED\"));",
