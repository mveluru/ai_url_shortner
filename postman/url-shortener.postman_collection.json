                  "  pm.expect(b.requestId).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(JSON.stringify(b)).to.not.match(/Exception|at com\\.|\\.java/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
