                  "  pm.expect(JSON.stringify(b)).to.not.match(/Exception|at com\\.|\\.java/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "urls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"longUrl\": \"http://169.254.169.254/latest/meta-data\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400: SSRF, octal-looking host",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error code is INVALID_URL\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_URL\"));",
                  "pm.test(\"body carries requestId and no internals\", () => {",
